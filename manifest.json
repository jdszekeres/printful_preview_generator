{
    "manifest_version": 3,
    "name": "Printful Preview Generator",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "index.html"
        
    },
    "content_scripts": [
        {
        "matches": ["https://*.printful.me//*"],
        "js": ["get_data.js"],
        "all_frames": true
        }
    ]

}